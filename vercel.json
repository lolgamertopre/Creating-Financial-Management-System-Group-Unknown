{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|icon-.*|pwa-.*|sw\\.js|registerSW\\.js|manifest\\.webmanifest).*)$",
      "destination": "/index.html"
    }
  ]
}

